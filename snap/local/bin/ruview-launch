#!/bin/sh
set -eu
umask 077

RUVIEW_DATA_DIR="${RUVIEW_DATA_DIR:-$SNAP_USER_COMMON/data}"
export RUVIEW_DATA_DIR
mkdir -p "$RUVIEW_DATA_DIR"

# Keep relative user paths and upstream CLI options intact.
for argument do
  case "$argument" in
    --ui-path | --ui-path=*) exec "$SNAP/bin/sensing-server" "$@" ;;
  esac
done
exec "$SNAP/bin/sensing-server" --ui-path "$SNAP/share/ruview/ui" "$@"
